PORT=3001

# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketmesh?retryWrites=true&w=majority"

# When deploying to Render, set MONGO_URI and JWT_SECRET in the Render dashboard as environment variables.
JWT_SECRET=change_me_to_a_strong_secret
NODE_ENV=development
